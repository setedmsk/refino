{
  "name": "voz-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de voz \u2014 app desktop",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.voz.desktop",
    "productName": "Voz",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Voz"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Network"
    }
  },
  "author": "setedmsk",
  "repository": "https://github.com/setedmsk/refino"
}
