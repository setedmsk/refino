# Banco. Local: crie o papel e o banco antes (veja o README).
DATABASE_URL="postgresql://voz:voz@localhost:5432/voz?schema=public"

# Segredo do JWT. Gere o seu:  openssl rand -base64 32
JWT_SECRET=""

# Origens de navegador aceitas pelo Socket.IO, separadas por virgula.
#
# VAZIO = aceita qualquer origem, e e o certo na maioria dos casos: quando o
# proprio Express serve o client, a origem muda conforme voce chega no
# servidor (localhost, IP da rede, tunel, dominio) e uma lista fixa bloqueia
# todas as outras — o socket morre e o app parece quebrado sem dizer por que.
#
# So preencha se o client estiver hospedado numa origem DIFERENTE do servidor.
# Quem protege o servidor e o token, nao o CORS.
CLIENT_ORIGIN=""

PORT=3001

# coturn com use-auth-secret.
#
# Vazios, o /api/ice devolve so STUN — serve para testar na mesma rede, mas
# entre redes diferentes a chamada nao fecha.
#
# TURN_SECRET tem que ser IDENTICO ao static-auth-secret do
# /etc/turnserver.conf. Divergir nao da erro em lugar nenhum: so falha para
# quem estiver atras de NAT dificil. Veja deploy/README.md.
TURN_HOST=""
TURN_SECRET=""
